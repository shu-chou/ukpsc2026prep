# Postgres connection string (Aiven, Neon, Railway, etc). Saves mock history across devices.
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
# Required whenever DATABASE_URL or ANTHROPIC_API_KEY is set. Protects your database and API credit.
APP_PASSCODE=choose-a-passcode
# Optional: enables "Fresh AI questions"
ANTHROPIC_API_KEY=
# Optional: override the model used for AI questions
# ANTHROPIC_MODEL=claude-sonnet-5
# Free alternative to Anthropic: get a key at https://aistudio.google.com/apikey (used first if set)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash  (tried first; others are automatic fallbacks)
